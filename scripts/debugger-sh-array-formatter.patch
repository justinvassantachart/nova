diff --git a/src/debug/types.rs b/src/debug/types.rs
index baad75e..aec2d6b 100644
--- a/src/debug/types.rs
+++ b/src/debug/types.rs
@@ -505,17 +505,43 @@ fn parse_subrange(die: &Die<'_>) -> (Value, Option<Value>) {
         .attr_value(gimli::DW_AT_lower_bound)
         .and_then(array_bound)
         .unwrap_or(Value::Constant(0));
-    let upper = die
+
+    // DW_AT_upper_bound is the inclusive index of the last element, but
+    // DW_AT_count is the element count — they're off by one. Clang emits
+    // DW_AT_count for C arrays, so convert it to upper = lower + count - 1
+    // before returning, so callers can treat the result uniformly.
+    let upper = if let Some(v) = die
         .attr_value(gimli::DW_AT_upper_bound)
         .and_then(array_bound)
-        .or_else(|| die.attr_value(gimli::DW_AT_count).and_then(array_bound));
+    {
+        Some(v)
+    } else if let Some(count) = die
+        .attr_value(gimli::DW_AT_count)
+        .and_then(array_bound)
+    {
+        match (&lower, &count) {
+            (Value::Constant(lo), Value::Constant(c)) => Some(Value::Constant(lo + c - 1)),
+            _ => Some(count),
+        }
+    } else {
+        None
+    };
+
     (lower, upper)
 }
 
 fn array_bound(value: gimli::AttributeValue<R>) -> Option<Value> {
     match value {
+        // Clang emits DW_AT_count / DW_AT_upper_bound for fixed-size arrays
+        // using DW_FORM_data1..8, not DW_FORM_udata, so we need to accept
+        // those raw integer forms too — otherwise array bounds parse as
+        // `None` and arrays render with type `T[]` instead of `T[N]`.
         gimli::AttributeValue::Udata(u) => Some(Value::Constant(u as i64)),
         gimli::AttributeValue::Sdata(s) => Some(Value::Constant(s)),
+        gimli::AttributeValue::Data1(u) => Some(Value::Constant(u as i64)),
+        gimli::AttributeValue::Data2(u) => Some(Value::Constant(u as i64)),
+        gimli::AttributeValue::Data4(u) => Some(Value::Constant(u as i64)),
+        gimli::AttributeValue::Data8(u) => Some(Value::Constant(u as i64)),
         gimli::AttributeValue::Exprloc(e) => Some(Value::Expr(e)),
         _ => None,
     }
