--- /dev/null
+++ b/src/debug/formatters/default/array.rs
@@ -0,0 +1,101 @@
+//! Raw C/C++ array formatter (e.g. `int arr[5]`).
+//!
+//! Without this formatter, [TypeDeclaration::Array](crate::debug::TypeDeclaration::Array)
+//! matches no entry in the formatter registry, so arrays render as
+//! `<unknown>` with no expansion.
+//!
+//! Mirrors the [`StdVectorFormatter`](crate::debug::formatters::cpp::StdVectorFormatter)
+//! pattern: bundle the per-call DWARF lookups in a single `data()` helper,
+//! present the array address via `display`, and expose elements as indexed
+//! children sliced by `child_at_offset`.
+
+use std::ops::Range;
+
+use anyhow::{Context, Result, bail};
+
+use crate::debug::formatters::{ChildCounts, VariableFormatter};
+use crate::debug::{Type, TypeDeclaration, Value, Variable};
+
+pub struct ArrayFormatter;
+
+struct ArrayData {
+    count: usize,
+    elem_ty: Type,
+    elem_size: usize,
+}
+
+impl ArrayFormatter {
+    fn data(value: &Variable) -> Result<ArrayData> {
+        let Some(TypeDeclaration::Array {
+            element_type,
+            lower_bound,
+            upper_bound,
+            ..
+        }) = value.ty().resolved()
+        else {
+            bail!("not an array type");
+        };
+
+        // DWARF subranges with no upper_bound describe flexible-array members
+        // (e.g. `int trailing[];`); render them as empty rather than guessing.
+        let count = match (lower_bound, upper_bound) {
+            (Value::Constant(lo), Some(Value::Constant(hi))) => (hi - lo + 1).max(0) as usize,
+            _ => 0,
+        };
+
+        let elem_ty = value.ty().child(*element_type);
+        let elem_size = elem_ty
+            .byte_size()
+            .context("array element size is unavailable")? as usize;
+
+        Ok(ArrayData {
+            count,
+            elem_ty,
+            elem_size,
+        })
+    }
+}
+
+impl VariableFormatter for ArrayFormatter {
+    fn matches(&self, ty: &Type) -> bool {
+        matches!(ty.resolved(), Some(TypeDeclaration::Array { .. }))
+    }
+
+    fn display(&self, value: &Variable) -> Result<String> {
+        match value.ty().resolved() {
+            Some(TypeDeclaration::Array { .. }) => Ok(match value.address() {
+                Some(addr) => format!("@{addr}"),
+                None => String::default(),
+            }),
+            _ => bail!("cannot format non-array value"),
+        }
+    }
+
+    fn num_children(&self, value: &Variable) -> Result<ChildCounts> {
+        Ok(ChildCounts::indexed(Self::data(value)?.count))
+    }
+
+    fn indexed_children(&self, value: &Variable, range: Range<usize>) -> Result<Vec<Variable>> {
+        let data = Self::data(value)?;
+        if data.elem_size == 0 {
+            return Ok(Vec::new());
+        }
+
+        let start = range.start.min(data.count);
+        let end = range.end.min(data.count);
+        let mut result = Vec::with_capacity(end.saturating_sub(start));
+        for i in start..end {
+            result.push(
+                value
+                    .child_at_offset(i * data.elem_size)
+                    .with_name(&format!("[{i}]"))
+                    .with_type(&data.elem_ty),
+            );
+        }
+        Ok(result)
+    }
+
+    fn named_children(&self, _value: &Variable, _range: Range<usize>) -> Result<Vec<Variable>> {
+        Ok(Vec::new())
+    }
+}
