+// Raw C array formatter: indexed children sourced from the array's storage.
+{
+  "steps": [
+    {
+      "type": "request",
+      "command": "setBreakpoints",
+      "arguments": {
+        "source": { "path": "main.cpp" },
+        "breakpoints": [{ "line": 3 }]
+      }
+    },
+    {
+      "type": "response",
+      "body": {
+        "breakpoints": {
+          "$array.contains": [{ "line": 3, "verified": true }]
+        }
+      }
+    },
+    {
+      "type": "request",
+      "command": "configurationDone",
+      "arguments": {}
+    },
+    {
+      "type": "event",
+      "event": "stopped",
+      "body": {
+        "reason": "breakpoint",
+        "threadId": "${{thread}}"
+      }
+    },
+    {
+      "type": "request",
+      "command": "stackTrace",
+      "arguments": { "threadId": "{{thread}}" }
+    },
+    {
+      "type": "response",
+      "body": {
+        "stackFrames": {
+          "$array.contains": [{ "name": "main", "id": "${{mainFrame}}" }]
+        }
+      }
+    },
+    {
+      "type": "request",
+      "command": "scopes",
+      "arguments": { "frameId": "{{mainFrame}}" }
+    },
+    {
+      "type": "response",
+      "body": {
+        "scopes": {
+          "$array.contains": [
+            {
+              "name": "Locals",
+              "variablesReference": "${{locals}}"
+            }
+          ]
+        }
+      }
+    },
+    {
+      "type": "request",
+      "command": "variables",
+      "arguments": {
+        "variablesReference": "{{locals}}"
+      }
+    },
+    {
+      "type": "response",
+      "body": {
+        "variables": {
+          "$array.contains": [
+            {
+              "name": "arr",
+              "type": "int[5]",
+              "indexedVariables": 5,
+              "variablesReference": "${{arr}}"
+            }
+          ]
+        }
+      }
+    },
+    {
+      "type": "request",
+      "command": "variables",
+      "arguments": {
+        "variablesReference": "{{arr}}"
+      }
+    },
+    {
+      "type": "response",
+      "body": {
+        "variables": [
+          { "name": "[0]", "value": "10", "variablesReference": 0 },
+          { "name": "[1]", "value": "20", "variablesReference": 0 },
+          { "name": "[2]", "value": "30", "variablesReference": 0 },
+          { "name": "[3]", "value": "40", "variablesReference": 0 },
+          { "name": "[4]", "value": "50", "variablesReference": 0 }
+        ]
+      }
+    },
+    {
+      "type": "request",
+      "command": "variables",
+      "arguments": {
+        "variablesReference": "{{arr}}",
+        "filter": "indexed",
+        "start": 1,
+        "count": 3
+      }
+    },
+    {
+      "type": "response",
+      "body": {
+        "variables": [
+          { "name": "[1]", "value": "20", "variablesReference": 0 },
+          { "name": "[2]", "value": "30", "variablesReference": 0 },
+          { "name": "[3]", "value": "40", "variablesReference": 0 }
+        ]
+      }
+    },
+    {
+      "type": "request",
+      "command": "continue",
+      "arguments": { "threadId": "{{thread}}" }
+    }
+  ]
+}
